# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais.
# Nunca commitar o ".env" de verdade.

# Assinatura da sessao/cookie do Flask-Login. Gere um valor aleatorio forte.
SECRET_KEY=

# Turso (libSQL) - banco de usuarios/mesas/fichas. Deixe em branco para usar
# um arquivo local (backend/app_data.db) durante o desenvolvimento.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Envio do e-mail de "esqueci minha senha" via API HTTPS da Resend
# (resend.com) - SMTP tradicional e' bloqueado na saida por hosts free tier
# como o Render. Deixe em branco para o link de redefinicao apenas aparecer
# no console do backend (modo de teste local).
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# URL publica do frontend, usada para montar o link de redefinicao de senha.
FRONTEND_BASE_URL=http://localhost:3000

# Usuario/senha da conta de administrador criada automaticamente no primeiro
# boot (e' a unica conta semeada - mestres sao criados pelo painel /admin).
# O repositorio e publico, entao os valores padrao (definidos em
# auth_service.py) sao visiveis a qualquer um - em producao, defina valores
# proprios aqui.
SEED_ADMIN_USUARIO=
SEED_ADMIN_SENHA=
