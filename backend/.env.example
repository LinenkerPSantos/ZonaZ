# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais.
# Nunca commitar o ".env" de verdade.

# Assinatura da sessao/cookie do Flask-Login. Gere um valor aleatorio forte.
SECRET_KEY=

# Turso (libSQL) - banco de usuarios/mesas/fichas. Deixe em branco para usar
# um arquivo local (backend/app_data.db) durante o desenvolvimento.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# SMTP para o e-mail de "esqueci minha senha". Deixe em branco para o link de
# redefinicao apenas aparecer no console do backend (modo de teste local).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# URL publica do frontend, usada para montar o link de redefinicao de senha.
FRONTEND_BASE_URL=http://localhost:3000
